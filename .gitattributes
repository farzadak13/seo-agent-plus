# Normalize line endings: LF in the repository, native in the working tree.
* text=auto

*.py text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Shipped to a Linux server by `git archive`, which applies core.autocrlf: on
# a Windows checkout these would otherwise arrive with CRLF, and bash reads
# "set -euo pipefail\r" as an invalid option.
*.sh text eol=lf
*.service text eol=lf
*.html text eol=lf
*.conf text eol=lf

# Copy to .env and adjust. .env is git-ignored and must never be committed.
#
# PowerShell does not read .env automatically. Either set these with
# $env:NAME = "value", or load the file with the snippet in docs/database.md.

# --- required ---------------------------------------------------------------
# Port 55432 is the container from docker-compose.yml, kept off 5432 so it
# cannot collide with a PostgreSQL installed directly on the machine.
# Any strong random string. There is no default and no fallback.
SEO_AGENT_API_KEY=replace-with-a-long-random-string
SEO_AGENT_DATABASE_DSN=postgresql://seoagent:seoagent_local_dev@127.0.0.1:55432/seoagent

# --- runtime ----------------------------------------------------------------
SEO_AGENT_ENV=development
SEO_AGENT_WORKER_ENABLED=true
SEO_AGENT_WORKER_POLL_INTERVAL_SECONDS=1.0
SEO_AGENT_OBSERVABILITY_ENABLED=true

# --- Search Console ---------------------------------------------------------
# stub = no network. live = real Search Console, needs a site with an
# access_token credential reference configured through the API.
SEO_AGENT_GSC_MODE=stub
SEO_AGENT_GSC_TIMEOUT_SECONDS=30
SEO_AGENT_MAX_WINDOW_DAYS=90

# Search Console keeps revising the last few days. A window that reaches into
# them looks like a traffic drop that never happened. 3 is what the API's
# behaviour shows; lower it only for a property you have measured.
SEO_AGENT_GSC_DATA_LAG_DAYS=3

# --- egress -----------------------------------------------------------------
# googleapis.com is unreachable from some networks. The proxy is a setting on
# one session, not a second code path, so development and production run the
# same thing.
# SEO_AGENT_GOOGLE_PROXY_URL=http://127.0.0.1:8080
# SEO_AGENT_GOOGLE_API_BASE=https://www.googleapis.com
# Refused in production: an unverified proxy can read and rewrite tokens.
SEO_AGENT_GOOGLE_VERIFY_TLS=true

# --- title recommendation path ----------------------------------------------
# Wholly on or wholly off: enabling it with serp/llm unset fails at startup.
SEO_AGENT_TITLE_WORKFLOW_ENABLED=false
SEO_AGENT_SERP_MODE=none
# SEO_AGENT_SERP_STATIC_PATH=fixtures/serp_snapshots.json
SEO_AGENT_LLM_MODE=none
# SEO_AGENT_ARVAN_ENDPOINT=https://...
# SEO_AGENT_ARVAN_MODEL=...
# The NAME of the environment variable holding the key, not the key itself.
# SEO_AGENT_ARVAN_API_KEY_REF=ARVAN_AI_KEY
# ARVAN_AI_KEY=...

# --- customer credentials ---------------------------------------------------
# Encrypts site credentials (e.g. WordPress application passwords) stored in
# the database. Unset: the API accepts only environment references. Generate
# one with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Rotate by putting a new key first, comma-separated, and keeping the old one.
# SEO_AGENT_SECRET_KEYS=

# --- sign in with Google ----------------------------------------------------
# Customers grant read-only Search Console access on Google's own screen,
# instead of adding the service account's email. All three or none; needs
# SEO_AGENT_SECRET_KEYS (refresh tokens are stored encrypted). The client's
# authorized redirect URI must be <public base url>/v1/oauth/google/callback.
# SEO_AGENT_GOOGLE_OAUTH_CLIENT_ID=
# SEO_AGENT_GOOGLE_OAUTH_CLIENT_SECRET=
# SEO_AGENT_PUBLIC_BASE_URL=https://hoshyarseo.ir

# --- keyword demand and rank tracking ---------------------------------------
# none | seosignal. Swapping provider is a new adapter, not a code change
# elsewhere (app/keyword_intel). The key is named, not given here.
SEO_AGENT_KEYWORD_PROVIDER=none
# SEO_AGENT_SEOSIGNAL_API_KEY_REF=SEOSIGNAL_API_KEY
# SEOSIGNAL_API_KEY=email:token
# Requests a day for the whole service (the account allows 50), and for any
# one customer. Answers are cached for 30 days, so these go a long way.
SEO_AGENT_KEYWORD_DAILY_BUDGET=40
SEO_AGENT_KEYWORD_TENANT_DAILY_BUDGET=10

# --- integration tests ------------------------------------------------------
# A throwaway database. These tests DROP their tables, which is why this is a
# separate variable from SEO_AGENT_DATABASE_DSN.
SEO_AGENT_TEST_DSN=postgresql://seoagent:seoagent_local_dev@127.0.0.1:55432/seoagent_test
